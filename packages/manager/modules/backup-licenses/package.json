{
  "name": "@ovh-ux/backup-licenses",
  "version": "0.1.0",
  "private": true,
  "description": "Shared onboarding module for the Backup Licenses product, consumed by the HPC and Bare Metal micro apps.",
  "license": "BSD-3-Clause",
  "author": "OVH SAS",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types/src/lib.d.ts",
      "import": "./dist/src/lib",
      "require": "./dist/src/lib.js"
    },
    "./package.json": {
      "import": "./package.json",
      "require": "./package.json"
    }
  },
  "main": "./dist/src/lib.js",
  "types": "./dist/types/src/lib.d.ts",
  "scripts": {
    "build": "tsc && tsc-alias",
    "dev": "tsc && tsc-alias",
    "dev:watch": "concurrently \"tsc --watch\" \"tsc-alias --watch\"",
    "lint:modern": "manager-lint --config eslint.config.mjs \"src/**/*.{ts,tsx}\"",
    "lint:modern:fix": "manager-lint --fix --config eslint.config.mjs \"src/**/*.{ts,tsx}\"",
    "prepare": "tsc && tsc-alias",
    "test": "manager-test run",
    "test:coverage": "manager-test run --coverage"
  },
  "devDependencies": {
    "@ovh-ux/manager-common-translations": "^0.29.0",
    "@ovh-ux/manager-core-api": "^0.20.0",
    "@ovh-ux/manager-react-components": "^2.43.1",
    "@ovh-ux/manager-static-analysis-kit": "^0.15.0",
    "@ovh-ux/manager-tests-setup": "^0.8.0",
    "@ovh-ux/manager-vite-config": "0.15.6",
    "@ovhcloud/ods-components": "^18.6.4",
    "@ovhcloud/ods-themes": "^18.6.4",
    "concurrently": "^8.2.2",
    "msw": "2.1.7",
    "tailwindcss": "^3.4.4",
    "tsc-alias": "^1.8.16",
    "typescript": "5.4.5"
  },
  "peerDependencies": {
    "@ovh-ux/manager-common-translations": "*",
    "@ovh-ux/manager-core-api": "*",
    "@ovh-ux/manager-core-test-utils": "*",
    "@ovh-ux/manager-react-components": "^2.15.1",
    "@ovh-ux/manager-react-shell-client": "^1.0.0",
    "@ovhcloud/ods-components": "^18.6.2",
    "@ovhcloud/ods-themes": "^18.6.2",
    "@tanstack/react-query": "5.61.5",
    "i18next": "^23.8.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^14.0.5",
    "react-router-dom": "^6.3.0"
  }
}
